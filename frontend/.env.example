# --- Clerk (auth, free tier) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Backend API base URL ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8123

# --- Nexconn Chat (Web SDK) ---
# /nexconn/token returns the App Key with the user token, so this is only a
# fallback for builds that prefer to bake it in. Never put the App Secret here.
NEXT_PUBLIC_NEXCONN_APP_KEY=
# Must match the data center assigned to the App Key (SG, NA, SA, OM, BJ).
NEXT_PUBLIC_NEXCONN_AREA_CODE=SG
